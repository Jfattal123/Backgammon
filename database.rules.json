{
  "rules": {
    "games": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-Z0-9]{5}$/)",
        "cfg": { ".write": "auth != null && !data.exists()" },
        "created": { ".write": "auth != null && !data.exists()" },
        "host": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
          "uid": { ".validate": "newData.val() === auth.uid" }
        },
        "guest": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
          "uid": { ".validate": "newData.val() === auth.uid" }
        }
      }
    }
  }
}
